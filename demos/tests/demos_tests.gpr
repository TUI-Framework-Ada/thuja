with "config/demos_tests_config.gpr";
with "config/demos_tests_list_config.gpr";

project Demos_Tests is
   for Source_Dirs use ("src/**", "common/", "config/");
   for Object_Dir use "obj/" & Demos_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use Demos_Tests_List_Config.Test_Files;

   package Compiler is
      for Default_Switches ("Ada") use
      Demos_Tests_Config.Ada_Compiler_Switches &
      ("-fprofile-arcs", "-ftest-coverage"); -- Added
   end Compiler;

   package Linker is
      for Default_Switches ("Ada") use ("-fprofile-arcs", "--coverage"); -- Added
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;
end Demos_Tests;
