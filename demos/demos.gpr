with "config/demos_config.gpr";

project Demos is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Demos_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   -- Build a single demo main to avoid gprbuild selecting multiple mains
   -- which can cause "not a source of project" errors on some systems.
   -- Point to the source file explicitly to avoid any Source_Dirs resolution issues
   for Main use ("comprehensive_demo", "resize_and_movement_demo", "keyboard_widget", "task_manager_demo", "htop_demo");

   package Compiler is
      for Default_Switches ("Ada") use Demos_Config.Ada_Compiler_Switches &
        ("-gnat2022",
         "-gnatwB",   --  Suppress fixed-point Small rounding (1.0/30.0 can't be exact)
         "-gnatwJ");  --  Suppress obsolescent () array syntax (toolchain lacks [] support)
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Demos;
