with "config/demos_config.gpr";

project Demos is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Demos_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("tab_demo");

   package Compiler is
      for Default_Switches ("Ada") use Demos_Config.Ada_Compiler_Switches &
        ("-gnat2022",
         "-gnatwB",
         "-gnatwJ",
         "-fprofile-arcs", "-ftest-coverage"); -- Added for coverage
   end Compiler;

   package Linker is
      -- We add the coverage flags for EVERY OS, then keep your psapi for Windows
      case Demos_Config.Alire_Host_OS is
         when "windows" =>
            for Default_Switches ("Ada") use ("-fprofile-arcs", "--coverage", "-lpsapi");
         when others =>
            for Default_Switches ("Ada") use ("-fprofile-arcs", "--coverage");
      end case;
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); 
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Demos;